# --- API Gateway Environment Variables ---

# Server Config
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI Service Connection
AI_SERVICE_DEV_URL=http://localhost:8000
AI_SERVICE_PRO_URL=https://your-ai-service.onrender.com

# Supabase Configuration & Authentication
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your-super-secret-jwt-string
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-share

# Core Databases
# Session pooler string from Supabase > Connect (the direct db.<ref> host is IPv6-only)
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6380

# (Optional) GitHub OAuth for repo importing
GITHUB_CLIENT_ID=your_github_oauth_id
GITHUB_CLIENT_SECRET=your_github_oauth_secret

# Must match ai-service INTERNAL_API_KEY
INTERNAL_API_KEY=change-me-long-random-string

# --- Notion MCP & Direct Integration (Phase 6) ---
# 1. NOTION_API_KEY:
#    Create an integration at: https://www.notion.so/profile/integrations
#    Format: starts with "ntn_" or "secret_"
NOTION_API_KEY=ntn_your-notion-internal-integration-token

# 2. NOTION_DATABASE_ID:
#    The 32-character ID of your Notion Database.
#    Found in the Notion URL: https://notion.so/<workspace>/<DATABASE_ID>?v=...
#    Make sure to click "..." -> "Connections" -> Add your integration in Notion!
NOTION_DATABASE_ID=your-32-char-notion-database-id

# 3. MCP_NOTION_SERVER_URL (Optional):
#    Only needed if routing through an intermediate Notion MCP server.
#    If NOTION_API_KEY and NOTION_DATABASE_ID are set, direct export is used.
MCP_NOTION_SERVER_URL=http://localhost:3001/mcp/notion
