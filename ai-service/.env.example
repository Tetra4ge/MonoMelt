# --- AI Analysis Service Environment Variables ---

# Server Config
PORT=8000

# Core Database & Storage (Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-share
# Use the Session pooler string (Supabase > Connect > Session pooler). The direct host
# db.<ref>.supabase.co is IPv6-only and fails on IPv4 networks.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_key
PINECONE_ENVIRONMENT=us-east-1

# Redis (used to publish report-updates for the API Gateway's WebSocket relay)
REDIS_URL=redis://localhost:6380

# AI Engine API (OpenRouter or Gemini)
OPENROUTER_API_KEY=sk-or-v1-...
GEMINI_API_KEY=your_gemini_api_key

# Shared secret the gateway/worker send as X-Internal-Key (leave empty only for local dev)
INTERNAL_API_KEY=change-me-long-random-string
# Comma-separated browser origins allowed to call this service directly
ALLOWED_ORIGINS=http://localhost:4000
